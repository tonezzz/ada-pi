GEMINI_API_KEY=your-google-ai-studio-key
# Extra keys for the side-tool pool (backend/gemini_pool.py — web_search,
# doc classify, summaries, decision/devteam checks, posture, TTS). The pool
# round-robins and marks a key exhausted per model on a 429 until the
# free-tier daily reset; extra projects or a billing-enabled key lift the
# 20/day wall with no code change.
# GEMINI_API_KEYS=key2,key3
# GEMINI_API_KEY_2=key2
# Force the drained-pool state for the forced-exhaust verification test:
# ADA_GEMINI_SIMULATE_EXHAUSTED=1
# Side-answer caches (repeat-heavy calls never reach the API):
# ADA_WEB_CACHE_TTL_S=900   ADA_DOC_CLASSIFY_CACHE_TTL_S=86400
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_LIVE_VOICE=Kore
GEMINI_LIVE_INSTRUCTIONS="You are a concise, friendly voice assistant."
# Used only for one-frame confirmation after local posture becomes suspected.
GEMINI_POSTURE_MODEL=gemini-3.5-flash-lite
# Persistent diagnostics (logs/ada-pi.log, rotated at 10 MB by default).
ADA_LOG_LEVEL=INFO
ADA_LOG_DIR=logs
ADA_LOG_MAX_BYTES=10485760
ADA_LOG_BACKUPS=5
# Local posture tracking database. Posture monitoring is always active while ADA
# runs; reminder cooldown is managed from Settings.
ADA_HABIT_DB=data/habits.db
# Gemini token usage ledger (append-only JSONL; powers the ada_usage_summary
# tool). Set to "off" to disable persistence.
# ADA_USAGE_LOG=data/usage.jsonl
# Daily/weekly rollup summaries over per-session summaries (powers the
# ada_daily_summary and ada_weekly_comparison tools). The daily digest
# regenerates after each persisted session; set to 0 to disable auto-rollup.
# ADA_DAILY_ROLLUP=1
# ADA_ROLLUP_MODEL=gemini-3.5-flash-lite
# Stable per-instance identity; pins the MDDB memory collections
# (snapshots/confidence/safety/events) to ada-ha-*-<id>. Required by
# pwa_server.py — the service refuses to start without it.
ADA_INSTANCE_ID=ada
# Member-invite PWA naming (docs/kb/ada-member-invite.md): the per-member
# install name is ADA-{INSTANCE}({Person}); INSTANCE defaults to
# "HA-<ADA_INSTANCE_ID uppercased>" (e.g. ADA-HA-TONY(KK)). Override with
# ADA_PWA_INSTANCE. ADA_PUBLIC_URL is the public origin used to build
# absolute invite links in the ada_member_keys tool (falls back to
# ADA_SELF_URL, then relative paths).
# ADA_PWA_INSTANCE=HA-TONY
# ADA_PUBLIC_URL=https://ada-pi.example.com
# API auth for pwa_server.py: gates mutating endpoints AND /ws. Clients unlock
# via ?api_key= or the HttpOnly cookie from POST /api/auth/session.
ADA_API_KEY=
# Optional named keys for audit logging/revocation: ADA_API_KEYS=tony:...,michael:...
# ADA_SESSION_TTL_S=43200
# Secret drop (POST /api/secret-drop — docs/kb/ada-secrets-hygiene.md):
# secrets land in ~/.config/secrets/<name> (0600); ADA_SECRETS_DIR overrides
# the dir, ADA_HOST_ALIAS marks an extra hostname as local (else ssh
# fan-out), ADA_SECRET_DROP_MAX_PER_HOUR tunes the per-key rate limit (5).
# ADA_SECRETS_DIR=~/.config/secrets
# ADA_HOST_ALIAS=idc03
# ADA_SECRET_DROP_MAX_PER_HOUR=5
# Read-only Home Assistant monitoring. Create a long-lived access token in the
# Home Assistant profile; it remains in ADA's backend and is never sent to the browser.
# start.sh starts this local Compose project and waits for HA before launching ADA.
ADA_START_HOME_ASSISTANT=true
ADA_HOME_ASSISTANT_COMPOSE_FILE=/home/naz/homeassistant/compose.yaml
HOME_ASSISTANT_URL=http://127.0.0.1:8123
HOME_ASSISTANT_TOKEN=
HOME_ASSISTANT_PERSON=person.naz
HOME_ASSISTANT_OFFICE_LIGHTS=light.left_office_light,light.right_office_light,light.office_chest_overhead_light,light.office_desk_overhead_light,light.office_desk_rbg_light
HOME_ASSISTANT_POLL_SECONDS=15
OFFICE_EMPTY_GRACE_SECONDS=300
ADA_TIMEZONE=America/New_York
# Vision chooses the 26-TOPS Hailo-8 and falls back to TFLite on failure.
ADA_VISION_BACKEND=auto
ADA_HAILO_MODEL_DIR=data/models/hailo8
# Optional model-only half-turn; disabled because the shared JPEG is upright.
ADA_HAILO_ROTATE_180=false
# Speaker identification via speechbrain ECAPA-TDNN.  When enabled, Ada
# identifies enrolled speakers from voice and injects the identity as
# context for Gemini.  Set to false to disable (e.g. if torch is not
# installed).  Enrolled voiceprints are stored locally in
# ADA_SPEAKER_PROFILES (default ~/.local/share/ada-pi/speaker_profiles.json).
ADA_SPEAKER_ID=true
# ADA_SPEAKER_PROFILES=~/.local/share/ada-pi/speaker_profiles.json
# ADA_SPEAKER_MODEL_DIR=/tmp/ada-speaker-model
# Kanban board comms tool (ada_board_write) — board-api base URL.
# ADA_BOARD_API_URL=https://tony-dell.taila0626a.ts.net/apps/board-api
# Market quote tool (ada_market_quote) — trade-api base URL serving the
# trade PostgreSQL (FX, Thai gold, DXY, WTI/Brent).
# ADA_TRADE_API_URL=https://tony-dell.taila0626a.ts.net/apps/trade/api
# Video render tool (ada_render_video) — uses GEMINI_API_KEY above.
# ADA_RENDER_VIDEO_MODEL=veo-3.1-fast-generate-preview
# ADA_RENDER_VIDEO_WAIT_S=120                   # bounded poll budget
# ADA_RENDER_VIDEO_POLL_S=6                     # poll interval
# ADA_RENDER_DIR=~/.local/share/ada/renders     # shared artifact store
# ADA_SELF_URL=http://127.0.0.1:8000            # for relative ref_url paths
# cms-regen auto-fix (scripts/ada/cms_regen.py + kanban_autofix.py):
# CMS API base for the /api/cms/pages/<slug>/regenerate endpoint.
# ADA_CMS_API_URL=http://127.0.0.1:8080
# MDDB_BASE_URL is already the registry/ledger store for these scripts.
# Durable write outbox: failed durable mddb writes retry with backoff for
# ADA_OUTBOX_WINDOW_S seconds before dead-lettering to dead-letters.jsonl
# under ADA_OUTBOX_DIR (default ~/.local/share/ada/outbox).
# ADA_OUTBOX_WINDOW_S=900
# ADA_OUTBOX_MAX_ATTEMPTS=12
# ADA_OUTBOX_DIR=~/.local/share/ada/outbox
# Session-scoped function_call mirror — appends each tool call/result as
# JSONL under ADA_CALL_LOG_DIR (default ~/.local/share/ada/call-logs) so
# journald rate-limit suppression can't erase the audit trail.
# ADA_CALL_LOG=1
# ADA_CALL_LOG_DIR=~/.local/share/ada/call-logs
# Unified voice+chat history (card ada-reads-text-chat): live same-owner
# sessions mirror each other's turns, and a per-owner rolling tail doc in
# the shared `ada-ha-recall-summary-shared` collection carries them across
# ada backends + restarts. Tuning:
# ADA_CHANNEL_LOG_KEEP=300      in-process ring buffer size
# ADA_CHANNEL_TAIL_TURNS=8      turns in the primed/persisted tail
# ADA_CHANNEL_TAIL_CHARS=1400   tail size cap
# ADA_CHANNEL_TAIL_MAX_AGE_S=21600  max turn age for the prime tail
# Local-model lanes (Chaba Nest /v1/systemone fleet — gemma-3-1b/4b).
# ADA_JEV_URL: advisory confirm-gate scorer (shadow vs the regex gate).
# ADA_JEV_URL=http://idc02:8777
# ADA_COMMAND_LLM_URL: short-command lane endpoint (falls back to
# ADA_JEV_URL — note a noul-only jev student answers choice questions
# with conf 0, i.e. the lane stays inert). Point it at a gemma lane for
# real routing: gemma-3-1b student (~1 cpu-s/call, fits the default
# timeout) — the 4b CPU lane measured 27-45s/call 2026-10-10, so it
# needs ADA_COMMAND_LANE_TIMEOUT_S≈60.
# ADA_COMMAND_LANE=off|shadow|enforce — shadow (default) classifies
# short turns fire-and-forget and writes
# ~/.local/share/ada/command-lane-corpus.jsonl; enforce actually answers
# confident short commands on TEXT turns through tool_runner's gates.
# Voice stays advisory in every mode — audio already streamed to Gemini.
# ADA_COMMAND_LLM_URL=http://idc03:8779
# ADA_COMMAND_LANE=shadow
# ADA_COMMAND_LANE_MAX_WORDS=12      candidate gate (Thai: char cap 36)
# ADA_COMMAND_LANE_MIN_CONF=0.65     route+entity-pick confidence floor
# ADA_COMMAND_LANE_TIMEOUT_S=8       per systemone call, then fall through
# ADA_COMMAND_LANE_CORPUS=~/.local/share/ada/command-lane-corpus.jsonl
