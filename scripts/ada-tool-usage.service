# systemd USER unit — idc01 checkout (~/.config/systemd/user/).
# Refreshes the CMS page report/tool-usage from the ada service journal
# so the tool census stays live between point-in-time audits.
# Install: cp to ~/.config/systemd/user/, systemctl --user daemon-reload,
#          systemctl --user enable --now ada-tool-usage.timer
[Unit]
Description=Ada tool-usage census -> CMS report/tool-usage
Documentation=https://github.com/tonezzz/ada-pi docs/assessments/tool-consolidation-spec-2026-10-04.md

[Service]
Type=oneshot
WorkingDirectory=%h/CascadeProjects/ada-pi
ExecStart=/usr/bin/env bash -lc 'PY=.venv/bin/python; [ -x "$PY" ] || PY=python3; exec "$PY" scripts/tool-usage-report.py'
# Journal reads can lag on a busy host; publishing is the slow step anyway.
TimeoutStartSec=120
